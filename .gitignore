# Camera data and complete experiment results are versioned with Git LFS.
# Runtime state and credentials stay local.
state/
__pycache__/
*.pyc
*.pyo
*.onnx
*.rknn
*.pth
*.pt
.env
.env.*
.ssh/
*.pem
*.key

# Include the tested default models and original SR fallback.
!depth_anything_v2/models/fp16.rknn
!depth_anything_v2/models/fp16-camera-518x294.rknn
!real_esrgan/models/fp16.rknn
!real_esrgan/models/fp16-trunk.rknn
!yolo11_bytetrack/models/int8.rknn

# Keep only the tested ARM64 executables, not CMake's generated files.
build/*
!build/advanced_vision
!build/model_batch
!build/sr_tiled
!build/npu_profile
!build/sr_tail_check
!build/hardware_tests
!build/core_tests
!build/render_tests
!build/async_writer_tests
